{
  "crons": [
    {
      "path": "/api/cron/send-scheduled",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/send-followups",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/newsletter/newsletter/:path*",
      "destination": "/newsletter/:path*",
      "permanent": false
    }
  ]
}
